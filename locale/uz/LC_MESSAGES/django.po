msgid "Долги и взаиморасчёты"
msgstr "Qarzlar va hisob-kitoblar"

msgid "Карточка долга"
msgstr "Qarz tafsilotlari"

msgid "Долг сохранён. Остаток пересчитан."
msgstr "Qarz saqlandi. Qoldiq qayta hisoblandi."

msgid "Редактирование долга"
msgstr "Qarzni tahrirlash"

msgid "Новый долг"
msgstr "Yangi qarz"

msgid "Обновите страницу и повторите действие."
msgstr "Sahifani yangilang va amalni takrorlang."

msgid "Запись восстановлена."
msgstr "Yozuv tiklandi."

msgid "Долг удалён из текущего учёта."
msgstr "Qarz joriy hisobdan chiqarildi."

msgid "Погашение записано. Остаток долга обновлён."
msgstr "To‘lov qayd etildi. Qarz qoldig‘i yangilandi."

msgid "Эта оплата уже записана. Повтор не создан."
msgstr "Bu to‘lov avval qayd etilgan. Takroriy yozuv yaratilmadi."

msgid "Погашение долга"
msgstr "Qarzni to‘lash"

msgid "Оплата отменена. Сумма возвращена в остаток долга."
msgstr "To‘lov bekor qilindi. Summa qarz qoldig‘iga qaytarildi."

msgid "Отмена оплаты"
msgstr "To‘lovni bekor qilish"

msgid "Проверьте имя пользователя и пароль. Учитывайте регистр букв."
msgstr ""
"Foydalanuvchi nomi va parolni tekshiring. Katta-kichik harflarga e’tibor "
"bering."

msgid "Эта учётная запись отключена."
msgstr "Bu hisob o‘chirilgan."

msgid "Имя пользователя"
msgstr "Foydalanuvchi nomi"

msgid "Пароль"
msgstr "Parol"

msgid "Файл Excel"
msgstr "Excel fayli"

msgid "Дата снимка"
msgstr "Ma’lumotlar sanasi"

msgid ""
"Если не указать, возьмём дату из имени файла. Даты самих операций не "
"изменятся."
msgstr ""
"Ko‘rsatilmasa, sana fayl nomidan olinadi. Operatsiyalarning sanalari "
"o‘zgarmaydi."

msgid "Дата начала должна быть раньше даты окончания."
msgstr "Boshlanish sanasi tugash sanasidan oldin bo‘lishi kerak."

msgid "Металл"
msgstr "Metall"

msgid "Транспорт"
msgstr "Transport"

msgid "Расчёты с партнёрами"
msgstr "Hamkorlar bilan hisob-kitoblar"

msgid "Хозяйственные расходы"
msgstr "Xo‘jalik xarajatlari"

msgid "Прочее"
msgstr "Boshqa"

msgid "Сумма операции не может быть нулевой."
msgstr "Operatsiya summasi nol bo‘lishi mumkin emas."

msgid "Тара не может превышать брутто."
msgstr "Tara brutto vaznidan oshmasligi kerak."

msgid "Кто должен"
msgstr "Kim qarzdor"

msgid "Нам должны"
msgstr "Bizga qarzdorlar"

msgid "Мы должны"
msgstr "Biz qarzdormiz"

msgid "Полная сумма долга, UZS"
msgstr "Qarzning to‘liq summasi, UZS"

msgid "Сумма до погашений. Внесённые оплаты вычитаются автоматически."
msgstr "To‘lovlardan oldingi summa. Kiritilgan to‘lovlar avtomatik ayiriladi."

msgid "Контрагент"
msgstr "Hamkor"

msgid "Основание долга / примечание"
msgstr "Qarz sababi / izoh"

msgid "Полная сумма долга не может быть меньше уже погашенной суммы."
msgstr "Qarzning to‘liq summasi to‘langan summadan kam bo‘lishi mumkin emas."

msgid "У долга с оплатами нельзя менять контрагента и сторону долга."
msgstr ""
"To‘lovlari bor qarzda hamkorni va qarzdor tomonni o‘zgartirib bo‘lmaydi."

msgid "Дата оплаты"
msgstr "To‘lov sanasi"

msgid "Сумма оплаты, UZS"
msgstr "To‘lov summasi, UZS"

msgid "Примечание"
msgstr "Izoh"

msgid "Дата фактической оплаты не может быть в будущем."
msgstr "Haqiqiy to‘lov sanasi kelajakda bo‘lishi mumkin emas."

msgid "Причина отмены"
msgstr "Bekor qilish sababi"

#, python-format
msgid "Ensure this value is less than or equal to %(limit_value)s."
msgstr "Qiymat %(limit_value)s dan katta bo‘lmasligi kerak."

#, python-format
msgid "Ensure this value is greater than or equal to %(limit_value)s."
msgstr "Qiymat %(limit_value)s dan kichik bo‘lmasligi kerak."

#, python-format
msgid ""
"Ошибка Excel %(error)s. Исходная формула сохранена; значение исключено из "
"расчётов."
msgstr ""
"Excel xatosi %(error)s. Asl formula saqlandi; qiymat hisob-kitoblardan "
"chiqarildi."

#, python-format
msgid ""
"В исходный итог включена корректировка %(amount)s UZS. Она не является "
"поставкой и не добавляется к стоимости отгрузок."
msgstr ""
"Asl jami summaga %(amount)s UZS tuzatish kiritilgan. Bu yetkazib berish emas "
"va jo‘natmalar qiymatiga qo‘shilmaydi."

#, python-format
msgid ""
"%(count)s денежных операций без даты. Они входят в общий итог, но не в "
"отчёты за период."
msgstr ""
"%(count)s ta pul operatsiyasida sana yo‘q. Ular umumiy jami summaga "
"kiritiladi, ammo davr hisobotlariga kiritilmaydi."

#, python-format
msgid "Строка %(row)s: %(error)s"
msgstr "%(row)s-qator: %(error)s"

msgid "На проверке"
msgstr "Tekshirish bosqichida"

msgid "Импортирован"
msgstr "Import qilingan"

msgid "Архив"
msgstr "Arxiv"

msgid "Дата"
msgstr "Sana"

msgid "Тип операции"
msgstr "Operatsiya turi"

msgid "Сумма, UZS"
msgstr "Summa, UZS"

msgid "Отрицательная сумма означает сторно в выбранном типе операции."
msgstr ""
"Manfiy summa tanlangan operatsiya turidagi storno — teskari yozuvni "
"bildiradi."

msgid "Назначение платежа"
msgstr "To‘lov maqsadi"

msgid "Категория"
msgstr "Toifa"

msgid "Отгрузка"
msgstr "Jo‘natish"

msgid "Приёмка"
msgstr "Qabul qilish"

msgid "Направление"
msgstr "Yo‘nalish"

msgid "Номер машины / описание"
msgstr "Mashina raqami / tavsif"

msgid "Брутто, кг"
msgstr "Brutto, kg"

msgid "Тара, кг"
msgstr "Tara, kg"

msgid "Скидка, %"
msgstr "Chegirma, %"

msgid "Цена, UZS/кг"
msgstr "Narx, UZS/kg"

msgid "Срок оплаты"
msgstr "To‘lov muddati"

msgid "Запись уже изменена. Обновите страницу и повторите действие."
msgstr ""
"Yozuv allaqachon o‘zgartirilgan. Sahifani yangilang va amalni takrorlang."

msgid "Запись изменена"
msgstr "Yozuv o‘zgartirildi"

msgid "Запись добавлена"
msgstr "Yozuv qo‘shildi"

msgid "Запись удалена из учёта"
msgstr "Yozuv hisobdan chiqarildi"

msgid "Запись восстановлена"
msgstr "Yozuv tiklandi"

msgid "Погашение отменено"
msgstr "Qarz to‘lovi bekor qilindi"

msgid ""
"Запись относится к архивному снимку. Восстановление в текущий учёт "
"недоступно."
msgstr "Yozuv arxiv nusxasiga tegishli. Uni joriy hisobga tiklab bo‘lmaydi."

msgid ""
"Сначала отмените погашения этого долга. История оплат должна сохраняться в "
"учёте."
msgstr ""
"Avval ushbu qarz to‘lovlarini bekor qiling. To‘lovlar tarixi hisobda "
"saqlanishi kerak."

msgid "Погашено"
msgstr "To‘langan"

msgid "В текущем учёте"
msgstr "Joriy hisobda"

msgid "Редактирование"
msgstr "Tahrirlash"

msgid "Создание"
msgstr "Yaratish"

msgid "Удаление"
msgstr "O‘chirish"

msgid "Восстановление"
msgstr "Tiklash"

msgid "Да"
msgstr "Ha"

msgid "Нет"
msgstr "Yo‘q"

msgid "Этот запрос уже использован для другой оплаты. Обновите страницу."
msgstr "Bu so‘rov boshqa to‘lov uchun ishlatilgan. Sahifani yangilang."

msgid "Долг больше не находится в текущем учёте."
msgstr "Qarz endi joriy hisobda mavjud emas."

msgid "Сумма оплаты должна быть больше нуля и не превышать остаток долга."
msgstr ""
"To‘lov summasi noldan katta bo‘lishi va qarz qoldig‘idan oshmasligi kerak."

msgid ""
"Оплата относится к архивному долгу. Его история доступна только для "
"просмотра."
msgstr "To‘lov arxivdagi qarzga tegishli. Uning tarixini faqat ko‘rish mumkin."

msgid "Укажите причину отмены оплаты."
msgstr "To‘lovni bekor qilish sababini ko‘rsating."

msgid "Объёмы и остатки"
msgstr "Hajmlar va qoldiqlar"

msgid "Расчёты и распределение прибыли"
msgstr "Hisob-kitoblar va foyda taqsimoti"

msgid "Отгрузки металла и взаиморасчёты"
msgstr "Metall jo‘natmalari va o‘zaro hisob-kitoblar"

msgid "Приёмка по контрагентам"
msgstr "Hamkorlar bo‘yicha qabul qilish"

msgid "Сводка взаиморасчётов"
msgstr "O‘zaro hisob-kitoblar jamlanmasi"

msgid "Основной денежный журнал"
msgstr "Asosiy pul operatsiyalari jurnali"

msgid "Бонусы по чермету"
msgstr "Qora metall bonuslari"

msgid "Расчёты с Рахимом"
msgstr "Rahim bilan hisob-kitoblar"

msgid "Объёмы по объектам"
msgstr "Obyektlar bo‘yicha hajmlar"

msgid "Оплаты и стоимость товара"
msgstr "To‘lovlar va tovar qiymati"

msgid "Расходы по гостинице"
msgstr "Mehmonxona xarajatlari"

msgid "Дополнительные бонусы"
msgstr "Qo‘shimcha bonuslar"

msgid "Приёмка чугуна"
msgstr "Cho‘yan qabul qilish"

msgid "Тип"
msgstr "Tur"

msgid "Назначение"
msgstr "Maqsad"

msgid ""
"Нет сохранённого результата формулы. Пересчитайте файл в Excel; ячейка "
"недоступна."
msgstr ""
"Formulaning saqlangan natijasi yo‘q. Faylni Excel’da qayta hisoblang; katak "
"qiymati mavjud emas."

msgid "Выберите файл .xlsx размером не больше 10 МБ."
msgstr "Hajmi 10 MB dan oshmaydigan .xlsx faylini tanlang."

msgid "Файл слишком велик после распаковки."
msgstr "Faylning arxivdan chiqarilgan hajmi juda katta."

msgid "Файлы с макросами не поддерживаются."
msgstr "Makrosli fayllar qo‘llab-quvvatlanmaydi."

msgid ""
"Не удалось прочитать Excel. Проверьте, что файл не повреждён и не защищён "
"паролем."
msgstr ""
"Excel faylini o‘qib bo‘lmadi. Fayl buzilmaganini va parol bilan "
"himoyalanmaganini tekshiring."

msgid "Поддерживаются книги до 30 листов, 12 000 строк и 64 колонок на лист."
msgstr ""
"30 tagacha varaq, har bir varaqda 12 000 tagacha qator va 64 tagacha ustun "
"qo‘llab-quvvatlanadi."

msgid "Исходные данные"
msgstr "Asl ma’lumotlar"

msgid "Брутто"
msgstr "Brutto"

msgid "Тара"
msgstr "Tara"

msgid "Цена"
msgstr "Narx"

msgid ""
"Названия листов знакомы, но колонки отличаются от образца. Импорт "
"остановлен, чтобы не перепутать суммы."
msgstr ""
"Varaq nomlari mos, ammo ustunlar namunadan farq qiladi. Summalar "
"adashmasligi uchun import to‘xtatildi."

msgid ""
"Не удалось прочитать сумму операции. Пересчитайте и исправьте формулу перед "
"импортом."
msgstr ""
"Operatsiya summasini o‘qib bo‘lmadi. Importdan oldin formulani tuzating va "
"qayta hisoblang."

msgid "Поставка пропущена: проверьте брутто, тару, цену и скидку."
msgstr ""
"Yetkazib berish o‘tkazib yuborildi: brutto, tara, narx va chegirmani "
"tekshiring."

msgid "Стоимость поставки превышает допустимый размер числа."
msgstr "Yetkazib berish qiymati ruxsat etilgan son chegarasidan oshgan."

msgid ""
"Смешанные суммы UZS/USD и текстовые заметки сохранены в исходном листе, без "
"пересчёта валют."
msgstr ""
"Aralash UZS/USD summalari va matnli qaydlar asl varaqda saqlandi, valyutalar "
"qayta hisoblanmadi."

msgid ""
"Начальный долг из строки 4 сохранён как расход по исходному журналу. Сальдо "
"журнала не означает прибыль."
msgstr ""
"4-qatordagi boshlang‘ich qarz asl jurnalga muvofiq chiqim sifatida saqlandi. "
"Jurnal saldosi foydani anglatmaydi."

msgid "Операции"
msgstr "Operatsiyalar"

msgid "Поставки"
msgstr "Yetkazib berishlar"

msgid "Колонки не совпадают с шаблоном. Скачайте шаблон на странице импорта."
msgstr ""
"Ustunlar shablonga mos emas. Import sahifasidan shablonni yuklab oling."

msgid "ID повторяется внутри файла"
msgstr "fayl ichida ID takrorlangan"

msgid "некорректная дата"
msgstr "sana noto‘g‘ri"

msgid "нужны тип, ненулевая сумма и назначение"
msgstr "tur, noldan farqli summa va to‘lov maqsadi kerak"

msgid "заполните направление, контрагента, машину и числовые поля"
msgstr "yo‘nalish, hamkor, mashina va raqamli maydonlarni to‘ldiring"

msgid "недопустимые веса, цена или скидка"
msgstr "vazn, narx yoki chegirma noto‘g‘ri"

msgid "ID уже существует. Строка пропущена; существующая запись не изменяется."
msgstr ""
"ID avvaldan mavjud. Qator o‘tkazib yuborildi; mavjud yozuv o‘zgarmaydi."

msgid ""
"Формат не распознан. Загрузите полную книгу с листами «Приход-Расход», «тура "
"ака», «Кунлик» либо наш шаблон «Операции» / «Поставки»."
msgstr ""
"Format aniqlanmadi. «Приход-Расход», «тура ака», «Кунлик» varaqlari mavjud "
"to‘liq kitobni yoki «Операции» / «Поставки» shablonimizni yuklang."

msgid "Этот файл уже обработан. Повторный импорт не выполнен."
msgstr "Bu fayl avval qayta ishlangan. Takroriy import bajarilmadi."

msgid ""
"Исправьте ошибки в файле и загрузите его заново. Частичный импорт отключён."
msgstr ""
"Fayldagi xatolarni tuzating va uni qayta yuklang. Qisman import o‘chirilgan."

msgid "Выберите способ обновления долгов."
msgstr "Qarzlarni yangilash usulini tanlang."

msgid ""
"Есть изменения долгов или погашения. Выберите, сохранить текущие долги или "
"принять остатки из новой книги."
msgstr ""
"Qarzlarda o‘zgarishlar yoki to‘lovlar bor. Joriy qarzlarni saqlashni yoki "
"yangi kitobdagi qoldiqlarni olishni tanlang."

msgid "Подтвердите замену изменений импортированных записей новым снимком."
msgstr ""
"Import qilingan yozuvlardagi o‘zgarishlarni yangi nusxa bilan almashtirishni "
"tasdiqlang."

msgid "Excel импортирован"
msgstr "Excel import qilindi"

msgid "Книги с календарём 1904 пока не поддерживаются."
msgstr "1904-yil taqvimidagi kitoblar hozircha qo‘llab-quvvatlanmaydi."


msgid "В книге слишком много листов."
msgstr "Kitobda varaqlar soni juda ko‘p."


msgid "Лист превышает допустимый размер."
msgstr "Varaq ruxsat etilgan hajmdan oshib ketdi."


msgid "Не удалось пересчитать книгу. Изменения не применены к учёту."
msgstr "Kitobni qayta hisoblab bo‘lmadi. O‘zgarishlar hisobga qo‘llanmadi."


msgid "Некорректные стили книги."
msgstr "Kitob uslublari noto‘g‘ri."


msgid "Некорректные данные книги."
msgstr "Kitob ma’lumotlari noto‘g‘ri."


msgid "Некорректный список листов."
msgstr "Varaqlar ro‘yxati noto‘g‘ri."


msgid "Состав листов исходной книги нельзя изменять."
msgstr "Asl kitobdagi varaqlar tarkibini o‘zgartirib bo‘lmaydi."


msgid "Некорректный лист."
msgstr "Varaq noto‘g‘ri."


msgid "Название исходного листа нельзя изменять."
msgstr "Asl varaq nomini o‘zgartirib bo‘lmaydi."


msgid "Структуру колонок исходной книги нельзя изменять."
msgstr "Asl kitob ustunlari tuzilishini o‘zgartirib bo‘lmaydi."


msgid "Некорректные строки листа."
msgstr "Varaq satrlari noto‘g‘ri."


msgid "Нарушена связь строк с учётом."
msgstr "Satrlarning hisob bilan bog‘lanishi buzilgan."


msgid "Некорректное содержимое ячейки."
msgstr "Katak mazmuni noto‘g‘ri."


msgid "Изменять структуру может только ответственный за формулы."
msgstr "Tuzilishni faqat formulalar uchun mas’ul shaxs o‘zgartirishi mumkin."


msgid "Некорректный адрес ячейки."
msgstr "Katak manzili noto‘g‘ri."


msgid "В книге слишком много ячеек."
msgstr "Kitobda kataklar soni juda ko‘p."


msgid "Формула слишком длинная или содержит внешнюю ссылку."
msgstr "Formula juda uzun yoki tashqi havolani o‘z ichiga oladi."


msgid "Формула содержит неподдерживаемую функцию: "
msgstr "Formulada qo‘llab-quvvatlanmaydigan funksiya bor: "


msgid "Ссылка в формуле превышает допустимый размер книги."
msgstr "Formuladagi havola kitobning ruxsat etilgan hajmidan oshib ketdi."


msgid "Недопустимое значение ячейки."
msgstr "Katak qiymati yaroqsiz."


msgid "Формулы защищены. Изменять их может только ответственный."
msgstr "Formulalar himoyalangan. Ularni faqat mas’ul shaxs o‘zgartirishi mumkin."


msgid "В книге должен оставаться видимый лист."
msgstr "Kitobda kamida bitta ko‘rinadigan varaq qolishi kerak."


msgid "Эта книга архивирована новым импортом. Доступны просмотр и скачивание."
msgstr "Yangi import sababli bu kitob arxivlangan. Uni ko‘rish va yuklab olish mumkin."


msgid "Строка потеряла связь с учётом. Обновите страницу."
msgstr "Satrning hisob bilan bog‘lanishi yo‘qolgan. Sahifani yangilang."


msgid "Импорт уже заменён. Откройте актуальную книгу."
msgstr "Import almashtirilgan. Amaldagi kitobni oching."


msgid "Рабочая книга создана"
msgstr "Ishchi kitob yaratildi"


msgid ""
"Книгу уже изменили в другой вкладке. Ваши правки сохранены на экране; "
"обновите книгу после сверки."
msgstr "Kitob boshqa oynada o‘zgartirilgan. Sizning tahrirlaringiz ekranda saqlanmoqda; solishtirgandan keyin kitobni yangilang."


msgid ""
"Версия книги изменилась во время сохранения. Обновите страницу после сверки "
